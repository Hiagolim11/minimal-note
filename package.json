{
  "name": "minimal-note",
  "productName": "Minimal Note",
  "version": "1.9.1",
  "description": "App de notas em Markdown inspirado no Obsidian — moderno, estilizado e personalizável.",
  "main": "main.js",
  "author": {
    "name": "Hiagolim11",
    "email": "Hiagolim11@users.noreply.github.com"
  },
  "homepage": "https://github.com/Hiagolim11/minimal-note",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "dist:win": "electron-builder --win nsis --x64",
    "build:linux-dir": "electron-builder --linux dir --x64",
    "dist:linux": "npm run build:linux-dir && node build/make-deb.js",
    "dist": "npm run dist:win && npm run dist:linux",
    "android:www": "node build/make-www.js",
    "android:assets": "electron build/make-android-assets.js",
    "android:sync": "npm run android:www && cap sync android",
    "android:apk": "npm run android:sync && cd android && (gradlew assembleRelease || sh gradlew assembleRelease)",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "bash test/e2e/all.sh",
    "prestart": "node build/make-vendor.js",
    "predist:win": "node build/make-vendor.js",
    "prebuild:linux-dir": "node build/make-vendor.js",
    "postinstall": "node build/make-vendor.js",
    "vendor": "node build/make-vendor.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/lora": "^5.0.0",
    "@fontsource-variable/outfit": "^5.0.0",
    "dompurify": "^3.1.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "dictionary-pt": "^4.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "hunspell-asm": "^4.0.2",
    "katex": "^0.16.11",
    "mermaid": "^11.4.1"
  },
  "build": {
    "appId": "com.minimalnote.app",
    "productName": "Minimal Note",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-capture.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Minimal-Note-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Minimal Note"
    },
    "linux": {
      "executableName": "minimal-note",
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
